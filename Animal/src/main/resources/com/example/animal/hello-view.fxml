<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.animal.HelloController">
    <center>
        <Canvas fx:id="canvas" width="600" height="600"/>
    </center>
    <bottom>
        <HBox spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <Button text="Pridať Herbivore" onAction="#onAddHerbivore"/>
            <Button text="Pridať Carnivore" onAction="#onAddCarnivore"/>
            <Button text="Zmeniť smer Carnivore" onAction="#onChangeDirection"/>
            <Button fx:id="btnStop" text="Zastaviť" onAction="#onToggleRun"/>
        </HBox>
    </bottom>
</BorderPane>