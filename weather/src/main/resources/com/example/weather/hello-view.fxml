<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>

<BorderPane prefHeight="500.0" prefWidth="800.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.weather.HelloController">
    <center>
        <Pane fx:id="pane" style="-fx-background-color: #5a6270;" />
    </center>
    <bottom>
        <HBox alignment="CENTER" spacing="8.0">
            <padding>
                <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
            </padding>
            <Button onAction="#onAddCloud" text="Pridať oblak" />
            <Button onAction="#onAddRaindrop" text="Pridať kvapku" />
            <Button onAction="#onAddSnowflake" text="Pridať vločku" />
            <Button fx:id="stopRainButton" onAction="#onToggleRain" text="Zastaviť dážď" />
            <Button onAction="#onBlueClouds" text="Oblaky na modro" />
            <Button onAction="#onMoveLeft" text="Posunúť o 20 px doľava" />
        </HBox>
    </bottom>
</BorderPane>